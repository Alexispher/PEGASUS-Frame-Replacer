from flask import Flask, render_template_string, redirect, url_for, session, flash
from functools import wraps
from flask_wtf import FlaskForm
from wtforms import StringField, PasswordField, SubmitField
from wtforms.validators import DataRequired

app = Flask(__name__)
app.secret_key = 'chave-secreta'
# Requisito para o CSRF funcionar com o Flask-WTF
app.config['WTF_CSRF_SECRET_KEY'] = 'chave-csrf'

# Formulário com proteção CSRF embutida
class LoginForm(FlaskForm):
    usuario = StringField('Usuário', validators=[DataRequired()])
    senha = PasswordField('Senha', validators=[DataRequired()])
    submit = SubmitField('Entrar')

# Usuários simulados
USUARIOS = {
    'admin': {'senha': '123'},
    'joao': {'senha': '456'}
}

# Decorator para proteger a rota
def login_required(f):
    @wraps(f)
    def wrapper(*args, **kwargs):
        if 'usuario' not in session:
            flash("Login necessário.", "erro")
            return redirect(url_for('login'))
        return f(*args, **kwargs)
    return wrapper

@app.route('/')
def index():
    return '<h2>Bem-vindo!</h2><a href="/login">Fazer Login</a> | <a href="/painel">Painel Protegido</a>'

@app.route('/login', methods=['GET', 'POST'])
def login():
    form = LoginForm()
    if form.validate_on_submit():
        usuario = form.usuario.data
        senha = form.senha.data
        if usuario in USUARIOS and USUARIOS[usuario]['senha'] == senha:
            session['usuario'] = usuario
            return redirect(url_for('painel'))
        else:
            flash("Credenciais inválidas.", "erro")
    
    # HTML do login
    html = '''
    <h2>Login (Protegido contra CSRF)</h2>
    {% with messages = get_flashed_messages(with_categories=true) %}
      {% for category, message in messages %}<p style="color: red;">{{ message }}</p>{% endfor %}
    {% endwith %}
    <form method="POST">
      {{ form.hidden_tag() }}
      <p>{{ form.usuario.label }} {{ form.usuario() }}</p>
      <p>{{ form.senha.label }} {{ form.senha() }}</p>
      <p>{{ form.submit() }}</p>
    </form>
    '''
    return render_template_string(html, form=form)

@app.route('/painel')
@login_required
def painel():
    html = '''
    <h2>Área Protegida VIP</h2>
    <p>Fala, {{ usuario }}! O sistema tá seguro.</p>
    <a href="/logout">Sair</a>
    '''
    return render_template_string(html, usuario=session['usuario'])

@app.route('/logout')
def logout():
    session.clear()
    flash("Você saiu do sistema.", "info")
    return redirect(url_for('index'))

if __name__ == '__main__':
    app.run(debug=True, host='0.0.0.0', port=8080)
